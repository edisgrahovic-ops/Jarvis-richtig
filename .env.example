# ============================================================================
#  Vorlage für deine Zugangsdaten
# ----------------------------------------------------------------------------
#  So gehst du vor:
#    1. Kopiere diese Datei und nenne die Kopie ".env"
#       (z. B. im Terminal:  cp .env.example .env )
#    2. Trage unten deine echten Werte ein.
#    3. Die Datei ".env" wird NICHT ins Git hochgeladen (siehe .gitignore) –
#       so bleiben deine Zugangsdaten geheim.
# ============================================================================

# Deine Shop-Adresse bei Shopify (die technische ".myshopify.com"-Adresse,
# NICHT deine schöne Domain stowestudio.de).
# Beispiel: stowe-studio.myshopify.com
# (Du findest sie im Shopify-Adminbereich oben in der Browser-Adresszeile.)
SHOPIFY_SHOP_DOMAIN=dein-shop.myshopify.com

# Der Admin-API-Access-Token deiner Custom App.
# Er beginnt mit "shpat_...". Wie du ihn bekommst, steht in der README.md.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Welche Version der Shopify-API benutzt werden soll.
# Falls du unsicher bist, lass diesen Wert einfach stehen.
SHOPIFY_API_VERSION=2025-07
