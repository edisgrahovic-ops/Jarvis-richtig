# -----------------------------------------------------------------------------
# Jarvis Konfiguration
# Kopiere diese Datei zu ".env" und trage eure echten Werte ein.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# 1) KI-Gehirn (Pflicht, damit Jarvis richtig denkt)
#    Schluessel anlegen unter: https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=

# 2) Shopify (optional – nur wenn Jarvis euren Shop lesen soll)
#    Anleitung siehe README.md, Abschnitt "Shopify verbinden".
SHOPIFY_STORE=
SHOPIFY_TOKEN=

# 3) Port (optional)
PORT=3000
