# Kopiere diese Datei zu ".env" und trage deinen Schlüssel ein.

# Welcher KI-Anbieter: "gemini" (kostenlos) oder "anthropic" (kostenpflichtig)
AI_PROVIDER=gemini

# --- Für Gemini (kostenlos, Standard) ---
# Kostenlosen Schlüssel holen auf https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Nur falls AI_PROVIDER=anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell überschreiben
#  gemini    -> Standard: gemini-2.0-flash  (kostenlos)
#  anthropic -> Standard: claude-opus-4-8
# JARVIS_MODEL=gemini-2.0-flash

# Optional: Port des Servers
PORT=3000
