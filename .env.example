# -----------------------------------------------------------------------------
# Jarvis Konfiguration
# Kopiere diese Datei zu ".env" und trage eure echten Werte ein.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# 1) KI-Gehirn – Jarvis nimmt automatisch das, wofuer ein Schluessel da ist.
#
#    EMPFOHLEN: Groq (GRATIS, ohne Kreditkarte, weltweit, sehr schnell)
#    Schluessel gratis anlegen unter: https://console.groq.com/keys
GROQ_API_KEY=
# Optional anderes Modell (Standard: llama-3.3-70b-versatile):
# GROQ_MODEL=llama-3.3-70b-versatile

#    ALTERNATIVE: Google Gemini (Gratis-Tarif nur in manchen Laendern verfuegbar)
#    Schluessel: https://aistudio.google.com/apikey  (muss mit "AIza..." beginnen)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# 2) Web-Recherche (optional – fuer ECHTE Live-Suche im Recherche-Modus 🔍)
#    Ohne diesen Schluessel antwortet Jarvis im Recherche-Modus aus seinem Wissen.
#    Gratis-Schluessel (1000 Suchen/Monat): https://app.tavily.com  -> beginnt mit "tvly-"
TAVILY_API_KEY=

# 3) Shopify (optional – nur wenn Jarvis euren Shop lesen soll)
#    Anleitung siehe README.md, Abschnitt "Shopify verbinden".
SHOPIFY_STORE=
SHOPIFY_TOKEN=

# 4) Port (optional)
PORT=3000
