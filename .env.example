# -----------------------------------------------------------------------------
# Jarvis Konfiguration
# Kopiere diese Datei zu ".env" und trage eure echten Werte ein.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# 1) KI-Gehirn: Google Gemini (KOSTENLOSES Kontingent, Pflicht damit Jarvis denkt)
#    Schluessel gratis anlegen unter: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Modell wechseln (Standard: gemini-2.5-flash, auch gratis).
# Alternative bei Problemen: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash

# 2) Shopify (optional – nur wenn Jarvis euren Shop lesen soll)
#    Anleitung siehe README.md, Abschnitt "Shopify verbinden".
SHOPIFY_STORE=
SHOPIFY_TOKEN=

# 3) Port (optional)
PORT=3000
